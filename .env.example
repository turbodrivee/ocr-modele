ENV=dev
LOG_LEVEL=INFO

# Internal-only auth between Node backend and Python OCR service.
# Required outside dev. During rotation, set both _PREVIOUS and the new one.
INTERNAL_SECRET=change-me
INTERNAL_SECRET_PREVIOUS=

# Legacy header accepted during rollout. Remove after one release.
LEGACY_API_KEY=

MAX_UPLOAD_BYTES=10485760
RATE_LIMIT_PER_MINUTE=30
